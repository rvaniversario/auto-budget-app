# Public address of the web app (links in emails).
APP_URL=http://localhost:5173
# Allowed browser origins for the API, comma-separated. "*" allows any.
APP_ORIGINS=http://localhost:5173,http://localhost:4173

# Email: Resend in production, or the local mail catcher in development.
# RESEND_API_KEY=re_xxx
EMAIL_FROM=Auto Budget <no-reply@example.com>
MAILPIT_URL=http://host.docker.internal:54334

# Shared secret for the hourly trial-reminders job.
CRON_SECRET=change-me

# Google Play billing (added with the Android app, see docs/SPEC-NATIVE.md):
# the Play Developer API service account key and the Pub/Sub push settings.
