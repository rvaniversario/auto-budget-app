# Secrets for the server functions. Copy to supabase/functions/.env for local
# development (`npx supabase start` loads it), and set the same names with
# `npx supabase secrets set` for the hosted project. Never commit real values.

# Public address of the app (checkout return links, emails).
APP_URL=http://localhost:5173
# Allowed browser origins for the API, comma-separated. "*" allows any.
APP_ORIGINS=http://localhost:5173,http://localhost:4173

# PayMongo (dashboard > Developers). Use sk_test_ keys until going live.
PAYMONGO_SECRET_KEY=sk_test_xxx
# The secret key PayMongo shows for your webhook endpoint.
PAYMONGO_WEBHOOK_SECRET=whsk_xxx

# Email: Resend in production, or the local mail catcher in development.
# RESEND_API_KEY=re_xxx
EMAIL_FROM=Auto Budget <no-reply@example.com>
MAILPIT_URL=http://host.docker.internal:54334
SUPPORT_EMAIL=support@example.com

# Shared secret for the hourly trial-reminders job.
CRON_SECRET=change-me
