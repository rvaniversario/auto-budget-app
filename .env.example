# Copy to .env and fill in what you need. Never commit .env.

# ---------------------------------------------------------------------------
# VPS deployment (docker-compose.yml)
# ---------------------------------------------------------------------------
# Public domain Caddy serves and gets an HTTPS certificate for.
# Its DNS record must point at the server. Leave unset to serve on localhost.
DOMAIN=budget.example.com

# ---------------------------------------------------------------------------
# App build settings (VITE_*)
# ---------------------------------------------------------------------------
# Values prefixed with VITE_ are read through import.meta.env and baked into the
# bundle at build time, so they are public: never put a secret here. With none
# of them set, the app runs fully on the device, exactly like version 1.

# Optional sign-in and online backup (Supabase). Both from the Supabase
# dashboard > Project Settings > API. The publishable key is public by design.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server functions base URL. Defaults to ${VITE_SUPABASE_URL}/functions/v1.
# VITE_API_URL=

# "true" shows "Continue with Google" (enable the Google provider in Supabase first).
# VITE_GOOGLE_SIGN_IN=true

# "true" shows Auto Budget Premium (paywall, badges, premium screens). Needs the
# Supabase settings above. Leave it off until test payments are verified.
# VITE_PREMIUM_ENABLED=true

# Shown on the payment confirmation page if confirming takes over a minute.
# VITE_SUPPORT_EMAIL=support@example.com

# Server secrets (PayMongo keys, email, the cron secret) never go in this file.
# They are server-only: see supabase/functions/.env.example and DEPLOY.md.
